<% layout("layouts/boilerplate") %>
<section class="projects-section py-5">
  <div class="container text-center">

    <h2 class="projects-title">All Projects</h2>
    <p class="projects-sub">
      A collection of websites and web applications I've worked on.
    </p>

    <div class="row justify-content-center g-4 mt-4">

      <!-- PROJECT 1 -->
      <div class="col-lg-4 col-md-6">
        <div class="project-card">
          <div class="project-img-box">
            <img src="/image/blossom.png" alt="Blossom World Senior Secondary School">
          </div>
          <h3>Blossom World School</h3>
          <div class="project-tags">
            <span>Education</span>
            <span>Admissions</span>
            <span>Responsive UI</span>
          </div>
          <p>
            A modern school website for an English-medium, co-educational senior secondary school with academics,
            gallery, and contact details.
          </p>
          <a href="https://blossomworldsilchar.com/" class="project-btn" target="_blank">Live Demo</a>
        </div>
      </div>

      <!-- PROJECT 2 -->
      <div class="col-lg-4 col-md-6">
        <div class="project-card">
          <div class="project-img-box">
            <img src="/image/ngo.png" alt="BNI Ficcha Foundation">
          </div>
          <h3>BNIF iccha Foundation</h3>
          <div class="project-tags">
            <span>Nonprofit</span>
            <span>Community</span>
            <span>Responsive</span>
          </div>
          <p>
            A trust-focused foundation website built to present the mission, programs, and community initiatives in a
            clean, approachable layout.
          </p>
          <a href="https://bnificchafoundation.in/" class="project-btn" target="_blank">Live Demo</a>
        </div>
      </div>

      <!-- PROJECT 3 -->
      <div class="col-lg-4 col-md-6">
        <div class="project-card">
          <div class="project-img-box">
            <img src="/image/daksha.png" alt="DakshamA Health and Education">
          </div>
          <h3>DakshaMed Health</h3>
          <div class="project-tags">
            <span>Healthcare</span>
            <span>Doctor</span>
            <span>Informational</span>
          </div>
          <p>
            An informative website for a health and education organization focused on awareness, accessibility, and
            public outreach.
          </p>
          <a href="https://www.dakshamed.com/" class="project-btn" target="_blank">Live Demo</a>
        </div>
      </div>

      <!-- PROJECT 4 -->
      <div class="col-lg-4 col-md-6">
        <div class="project-card">
          <div class="project-img-box">
            <img src="/image/wonder.png" alt="Wanderlust">
          </div>
          <h3>Wanderlust</h3>
          <div class="project-tags">
            <span>MERN</span>
            <span>Node.js</span>
            <span>MongoDB</span>
          </div>
          <p>
            An online booking platform that allows users to browse listings, make reservations, and manage bookings
            easily through a secure and user-friendly interface.
          </p>
          <a href="https://wanderlust-7y7v.onrender.com/listings" class="project-btn" target="_blank">Live Demo</a>
        </div>
      </div>

      <!-- PROJECT 5 -->
      <div class="col-lg-4 col-md-6">
        <div class="project-card">
          <div class="project-img-box">
            <img src="/image/wonderLust.png" alt="Consultancy Portal">
          </div>
          <h3>Consultancy Portal</h3>
          <div class="project-tags">
            <span>Admin Panel</span>
            <span>MongoDB</span>
            <span>Express.js</span>
          </div>
          <p>
            A business website that collects client enquiries and allows the owner to manage submissions easily through
            a secure admin panel.
          </p>
          <a href="https://consultancy-cevb.onrender.com/apply/Home" class="project-btn" target="_blank">Live Demo</a>
        </div>
      </div>

      <!-- PROJECT 6 -->
      <div class="col-lg-4 col-md-6">
        <div class="project-card">
          <div class="project-img-box">
            <img src="/image/doctor.png" alt="Clinic Website">
          </div>
          <h3>Clinic Website</h3>
          <div class="project-tags">
            <span>HTML</span>
            <span>Bootstrap</span>
            <span>Responsive UI</span>
          </div>
          <p>
            A responsive clinic website designed to showcase services and help patients easily contact the clinic from
            any device.
          </p>
          <a href="https://rajesh-gour123.github.io/Doctor-website/" class="project-btn" target="_blank">Live Demo</a>
        </div>
      </div>

    </div>

